# Backstage Bootstrap - Azure Infrastructure
# This module provisions the infrastructure needed to run Backstage on Azure.

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = ">= 3.0"
    }
  }
}

provider "azurerm" {
  features {}
}
